# Demo Configuration Example
# Copy this file to .env in the root directory and fill in your values

# ============================================================================
# Azure Cosmos DB (Required for demos with memory)
# ============================================================================
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# COSMOS_KEY=your_cosmos_key_here  # Optional - will use DefaultAzureCredential if not provided
AZURE_COSMOS_DATABASE_NAME=agent_memory_db
AZURE_COSMOS_INTERACTIONS_CONTAINER=interactions
AZURE_COSMOS_SUMMARIES_CONTAINER=session_summaries
AZURE_COSMOS_INSIGHTS_CONTAINER=insights

# ============================================================================
# Azure OpenAI (Required for all demos)
# ============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_REASONING_MODEL=gpt-4o
AZURE_OPENAI_PROCESSING_MODEL=gpt-4o
AZURE_OPENAI_EMB_DEPLOYMENT=text-embedding-ada-002

# ============================================================================
# Authentication (demos use AzureCliCredential by default)
# ============================================================================
# Run: az login
# No additional environment variables needed!

# ============================================================================
# Quick Setup Instructions
# ============================================================================
# 1. Ensure you're logged in to Azure CLI:
#    az login
#
# 2. Copy this file to the repository root:
#    cp demo/.env.example .env
#
# 3. Fill in your Azure credentials (COSMOS_ENDPOINT, AZURE_OPENAI_ENDPOINT, etc.)
#
# 4. Run demos:
#    uv run demo/hidden_tool_demo.py
#    uv run demo/comparison_tool_injection_demo.py
